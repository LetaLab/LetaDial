# Konfiguracja — NIGDY na GitHub (hasła, klucze)
config.php
config.php.bak*

# Dane użytkowników
storage/thumbnails/*
storage/avatars/*
storage/group_icons/*
storage/sessions/*

# Zachowaj strukturę katalogów storage
!storage/thumbnails/.gitkeep
!storage/avatars/.gitkeep
!storage/group_icons/.gitkeep
!storage/sessions/.gitkeep

# Logi
logs/*
!logs/.gitkeep

# OPSEC-01: prywatne configi per-host — zawieraja realny adres IP, uklad
# sieci domowej i sciezki certyfikatow. Uzyj nginx_letadial_example.conf
# (z placeholderami CHANGEME) jako wzorca do publikacji zamiast tych plikow.
# OPSEC-02: poprzednia wersja tej reguly mieszala dwa niekompletne style —
# dwa wzorce z kropka (*.andrzejl.eu.txt / *.letalab.eu.txt) i dwie
# DOKLADNE nazwy plikow (dashboard_andrzejl_eu.txt / letadial_letalab_eu.txt).
# Trzeci plik z ta sama konwencja co-hosta (letadial_andrzejl_eu.txt) nie
# pasowal do zadnego z tych czterech wzorcow i NIE byl ignorowany — mogl
# trafic do publicznego repo razem z realnym IP/siecia/sciezkami certyfikatow.
# Zastapione czterema wzorcami-glob, kazdy odporny na oba warianty nazewnictwa
# (kropka LUB podkreslnik) dla obu hostow, wiec przyszly plik per-host o
# analogicznej nazwie jest ignorowany automatycznie, bez recznego dopisywania.
*andrzejl_eu.txt
*andrzejl.eu.txt
*letalab_eu.txt
*letalab.eu.txt

# OPSEC-01: osobiste eksporty testowe — zawieraja realne domeny prywatne,
# adresy wewnetrzne i nazwy uslug home-labowych.
*_letadial_export_*.json

# SEC-119: LetaDial_Permissions.sh (root-executed permission/cleanup script)
# must never be tracked in this repo — its whole security model (see its own
# header comment and README.md -> Permissions) depends on it living OUTSIDE
# the git-tracked, auto-updatable app directory, so a compromised origin can
# never modify a script that later runs as root. The canonical copy to
# deploy lives embedded as a heredoc inside README.md, not as a standalone
# repo file. Covers both the current name and its pre-rename form.
LetaDial_Permissions.sh
fix_permissions.sh

# System
.DS_Store
Thumbs.db
*.swp
*.swo
